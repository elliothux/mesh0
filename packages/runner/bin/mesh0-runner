#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOCAL_RUNNER="${SCRIPT_DIR}/../src/mesh0-runner.ts"
IMAGE_RUNNER="/usr/local/lib/mesh0-runner/dist/mesh0-runner.js"

if [ -f "${LOCAL_RUNNER}" ]; then
  exec bun "${LOCAL_RUNNER}" "$@"
fi

exec bun "${IMAGE_RUNNER}" "$@"
