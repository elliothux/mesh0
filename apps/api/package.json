{
  "name": "@mesh0/api",
  "private": true,
  "description": "Remote server for Mesh0",
  "type": "module",
  "exports": {
    ".": "./src/routes/index.ts"
  },
  "scripts": {
    "db:migrate:local": "wrangler d1 migrations apply mesh0 --local",
    "db:migrate:remote": "wrangler d1 migrations apply mesh0 --remote",
    "deploy": "wrangler deploy src/index.ts",
    "dev": "wrangler dev src/index.ts --port 5592",
    "typecheck": "tsc --noEmit"
  }
}
