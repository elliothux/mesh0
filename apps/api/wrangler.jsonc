{
  "name": "mesh0-api",
  "main": "src/worker.ts",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-02-24",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_DOMAIN": "mesh0.run"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mesh0",
      "database_id": "8175347b-1a6f-4cb2-abff-2929a1b08ac5",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RUNS_BUCKET",
      "bucket_name": "mesh0-runs"
    }
  ],
  "containers": [
    {
      "class_name": "Mesh0RunnerSandbox",
      "image": "../../packages/runner/Dockerfile",
      "image_build_context": "../../packages/runner",
      "instance_type": "basic",
      "max_instances": 100
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RUNNER_CONTAINER",
        "class_name": "Mesh0RunnerSandbox"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Mesh0RunnerSandbox"]
    }
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "placement": {
    "mode": "smart"
  }
}
